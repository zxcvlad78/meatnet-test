[gd_scene format=3 uid="uid://bqh6oi0b30s30"]

[sub_resource type="GDScript" id="GDScript_2k4rt"]
script/source = "extends Node

var client = null
@onready var label: Label = $Label

@onready var line_edit: LineEdit = $VBoxContainer/LineEdit
@onready var button_connect: Button = $VBoxContainer/ButtonConnect
@onready var button_disconnect: Button = $VBoxContainer/ButtonDisconnect

func _ready() -> void:
	client = MeatNetClient.new()
	
	button_connect.pressed.connect(
		func(): print(\"connect error: \", client.connect(line_edit.text))
	)
	button_disconnect.pressed.connect(
		func(): client.close()
	)


func _process(_delta: float) -> void:
	client.update()
	
	label.text = \"\"\" Client\\n
	is_active: %s\\n
	connection_id: %s\\n
	\"\"\" % [
		client.is_active(),
		client.get_connection_id()
		]
"

[node name="Client" type="Node" unique_id=1367465544]
script = SubResource("GDScript_2k4rt")

