[sub_resource type="GDScript" id="GDScript_2k4rt"]
script/source = "extends Node

var client: MeatNetClient = null
@onready var label: Label = $Control/Label
@onready var label_2: Label = $Control/Label2


@onready var line_edit: LineEdit = $Control/VBoxContainer/LineEdit
@onready var button_connect: Button = $Control/VBoxContainer/ButtonConnect
@onready var button_disconnect: Button = $Control/VBoxContainer/ButtonDisconnect
@onready var msg_line_edit: LineEdit = $Control/VBoxContainer/MsgLineEdit
@onready var button_send_message: Button = $Control/VBoxContainer/ButtonSendMessage

@onready var fucktheclubup: AudioStreamPlayer = $fucktheclubup

@export var audio_list:Array[AudioStream]

@onready var meat_net_voice: MeatNetVoice = $MeatNetVoice
@onready var meat_net_voice_listener: MeatNetVoiceListener = $MeatNetVoiceListener


func _ready() -> void:
	client = MeatNetClient.new()
	client.message_received.connect(_on_msg_received)
	
	
	
	button_connect.pressed.connect(
		func(): print(\"connect error: \", client.connect(line_edit.text))
	)
	button_disconnect.pressed.connect(
		func(): client.close()
	)
	
	button_send_message.pressed.connect(
		func():
			if msg_line_edit.text.is_empty(): return
			if client:
				var data: Dictionary = {}
				data[\"type\"] = \"chat_message\"
				data[\"text\"] = msg_line_edit.text
				var bytes: PackedByteArray = var_to_bytes(data)
				client.send(bytes, true)
	)


func _on_msg_received(data: PackedByteArray):
	var received_data: Dictionary = bytes_to_var(data)
	var received_packed_type: String = received_data[\"type\"]
	
	if received_packed_type == \"chat_message\":
		label_2.text += received_data[\"text\"] + \"\\n\"
	
	elif received_packed_type == \"voice\":
		print(\"Received voice packet, size: \", received_data[\"bytes\"].size())
		meat_net_voice_listener.msg_process(received_data)
	
	elif received_packed_type == \"fucktheclubup\":
		if audio_list.is_empty():
			return
		var audio_id: int = received_data[\"audio_id\"]
		if audio_id > audio_list.size():
			return
		
		fucktheclubup.stream = audio_list[audio_id]
		fucktheclubup.play()
		label_2.text += \"fucktheclubup xD\\n\"

func _process(delta: float) -> void:
	meat_net_voice.update(client, delta)
	client.update()
	
	label.text = \"\"\" Client\\n
	is_active: %s\\n
	connection_id: %s\\n
	\"\"\" % [
		client.is_active(),
		client.get_connection_id()
		]
"

